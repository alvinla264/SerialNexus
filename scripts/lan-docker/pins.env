# Pinned container images for the Docker LAN gate.
#
# Both are official Docker Hub library images, pinned by digest so a rerun
# builds the same binaries against the same C library months later. The build
# stage is the full `rust` image because `ring` (rustls's provider) compiles C
# and assembly and needs a C toolchain; the runtime stage is plain Debian
# because the gate runs only the workspace's own binaries.
#
# `rust:1.85-bookworm` matches the workspace's declared Rust 1.85 minimum, so
# the gate's build is the same compiler floor CI checks.
#
# Refresh deliberately, with the results of a passing run recorded:
#   docker pull rust:1.85-bookworm
#   docker pull debian:12-slim
#   docker image inspect --format '{{.RepoDigests}}' rust:1.85-bookworm debian:12-slim
RUST_IMAGE=rust@sha256:e51d0265072d2d9d5d320f6a44dde6b9ef13653b035098febd68cce8fa7c0bc4
RUNTIME_IMAGE=debian@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
